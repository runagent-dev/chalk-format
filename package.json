{
  "name": "chalk-format",
  "version": "0.0.0",
  "private": true,
  "description": "The .chalk interactive book format: spec, schema, container, converters and readers.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r --parallel lint",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "gen:schema": "tsx scripts/gen-schema.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.16.0",
    "globals": "^15.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "tsx": "^4.19.2",
    "zod": "^4.4.3",
    "@chalk-format/model": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
