{
  "name": "@chalk-format/pdf-engine",
  "private": true,
  "version": "0.0.0",
  "description": "PDF pages to Chalk lesson pages with pdf.js: page rendering, text layer and staging.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./staging": "./src/staging.ts",
    "./text-layer": "./src/text-layer.ts",
