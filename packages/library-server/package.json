{
  "name": "@chalk-format/library-server",
  "version": "0.0.0",
  "description": "A Chalk library server: the registry API (spec/1.2/registry-api.md) over Postgres and S3-compatible storage (R2, MinIO, AWS) or a disk.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "chalk-library": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "tsx src/cli.ts serve",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@chalk-format/model": "workspace:*",
    "@chalk-format/store": "workspace:*",
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
