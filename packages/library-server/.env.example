# A Chalk library server. Copy to .env (never commit .env). See src/config.ts for every setting.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
DB_SCHEMA=chalk_library
STORAGE=s3
# Cloudflare R2 (any S3-compatible service works: MinIO, AWS S3, Backblaze B2, …)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=<bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# where students' readers fetch the bytes: the bucket's custom domain (behind Cloudflare's cache)
PUBLIC_URL=https://assets.example.org/
# this server's public address: the issuer (iss) of its access tokens
SERVER_URL=https://library.example.org
# bootstrap tokens: name:token, comma separated; a plain name is an author, a name ending in ! an administrator.
# Users and API keys: chalk-library user add … / key add … (see docs/guides/run-a-library-server.md)
TOKENS=teacher:change-me,admin!:change-me-too
# encrypts the token signing keys in the database; required once there are users or PUBLIC_READ=false.
# openssl rand -base64 32 (the CLI needs the same value)
AUTH_KEY_SECRET=
# false: reading needs a token, bytes included (readers use <SERVER_URL>/v1/files/{h}); make the bucket private yourself,
# see docs/guides/run-a-library-server.md "A private library"
PUBLIC_READ=true
# behind a reverse proxy (Coolify, nginx): take the client's address from X-Forwarded-For for sign-in rate limits
TRUST_PROXY=false
# where in its own bucket the library adopts files in place (POST /v1/assets/adopt), e.g. chalk-books/; empty: off
ADOPT_PREFIXES=
PORT=8080
