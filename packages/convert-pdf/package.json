{
  "name": "@chalk-format/convert-pdf",
  "private": true,
  "version": "0.0.0",
  "description": "Convert a PDF into a .chalk book in Node.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@chalk-format/model": "workspace:*",
    "@chalk-format/container": "workspace:*",
    "@chalk-format/pdf-engine": "workspace:*",
    "@napi-rs/canvas": "^0.1.100",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "vitest": "^2.1.8"
  }
}
