{
  "name": "@chalk-format/reader",
  "private": true,
  "version": "0.0.0",
  "description": "The reference reader and editor for .chalk books: a configurable React component.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.mjs src/styles.css src/fonts.css"
  },
  "dependencies": {
    "@chalk-format/container": "workspace:*",
    "@chalk-format/lab": "workspace:*",
    "@chalk-format/model": "workspace:*",
    "@chalk-format/pdf-engine": "workspace:^",
    "@fontsource/noto-sans": "^5.2.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@google/model-viewer": "^4.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "perfect-freehand": "^1.2.3",
    "three": "^0.183.0",
    "@chalk-format/store": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vitest": "^2.1.8"
  }
}
