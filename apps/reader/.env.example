# Copy to .env.local (git-ignored) to connect the showcase's editor to a library server on first visit.
# Without a token the library is read-only (search and place); with one, the editor can upload into it.
# The token ends up in the browser bundle: use .env.local for local work only, never for a public build.
VITE_CHALK_LIBRARY_URL=https://library.pathshalax.com
VITE_CHALK_LIBRARY_NAME=PathshalaX library
VITE_CHALK_LIBRARY_TOKEN=
