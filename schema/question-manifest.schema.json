{
  "$id": "https://chalk-format.dev/schema/v11/question-manifest.schema.json",
  "title": "Chalk question manifest, what a store keeps about a question (spec 1.6)",
  "x-chalk-format-version": 11,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "chalk.question"
    },
    "manifestVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "stem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "correct": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "text"
        ],
        "additionalProperties": {}
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "stem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "marks": {
            "type": "number",
            "minimum": 0
          },
          "level": {
            "type": "string",
            "maxLength": 40
          },
          "answer": {
            "type": "object",
            "properties": {
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              },
              "detail": {
                "type": "string",
                "enum": [
                  "final",
                  "full"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string",
                "maxLength": 40
              }
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "label",
          "stem"
        ],
        "additionalProperties": {}
      }
    },
    "answer": {
      "type": "object",
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "detail": {
          "type": "string",
          "enum": [
            "final",
            "full"
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 40
        }
      },
      "additionalProperties": {}
    },
    "marks": {
      "type": "number",
      "minimum": 0
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "level": {
      "type": "string",
      "maxLength": 40
    },
    "subject": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "book": {
          "type": "string",
          "maxLength": 300
        },
        "edition": {
          "type": "string",
          "maxLength": 100
        },
        "number": {
          "type": "string",
          "maxLength": 40
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": {}
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:sha256:[0-9a-f]{64}|c1:[a-z2-7]{25}[aeimquy4])$"
      }
    },
    "license": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "manifestVersion",
    "id",
    "version",
    "kind",
    "stem"
  ],
  "additionalProperties": {}
}
