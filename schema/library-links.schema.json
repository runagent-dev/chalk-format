{
  "$id": "https://chalk-format.dev/schema/v11/library-links.schema.json",
  "title": "Chalk links item, sentences of a book linked to questions (spec 1.8 §3.4)",
  "x-chalk-format-version": 11,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "chalk-links"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "book": {
      "type": "string",
      "minLength": 1
    },
    "bookRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "rects": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            }
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "page",
          "pageId",
          "rects",
          "text"
        ],
        "additionalProperties": {}
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sentence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "question": {
            "type": "string",
            "pattern": "^c1:[a-z2-7]{25}[aeimquy4]$"
          },
          "questionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "sentence",
          "question",
          "role"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "format",
    "version",
    "book",
    "bookRevision",
    "sentences",
    "links"
  ],
  "additionalProperties": {}
}
