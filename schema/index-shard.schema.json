{
  "$id": "https://chalk-format.dev/schema/v10/index-shard.schema.json",
  "title": "Chalk index shard (spec 1.2 §5.3)",
  "x-chalk-format-version": 10,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z2-7]{25}[aeimquy4]$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "p": {
            "type": "string",
            "minLength": 1
          },
          "s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "t": {
            "type": "string"
          }
        },
        "required": [
          "p"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "v",
    "entries"
  ],
  "additionalProperties": {}
}
