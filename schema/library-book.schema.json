{
  "$id": "https://chalk-format.dev/schema/v11/library-book.schema.json",
  "title": "Chalk book item, a streamed book index kept in a library (spec 1.8 §3.1)",
  "x-chalk-format-version": 11,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "chalk.streamed"
    },
    "streamVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "coverAssetId": {
      "type": "string"
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "assetBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "thumb": {
            "type": "string"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key": {
            "type": "string",
            "pattern": "^c1:[a-z2-7]{25}[aeimquy4]$"
          },
          "file": {
            "not": {}
          }
        },
        "required": [
          "id",
          "key"
        ],
        "additionalProperties": {}
      }
    },
    "snipPages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "assetBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "thumb": {
            "type": "string"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key": {
            "type": "string",
            "pattern": "^c1:[a-z2-7]{25}[aeimquy4]$"
          },
          "file": {
            "not": {}
          }
        },
        "required": [
          "id",
          "key"
        ],
        "additionalProperties": {}
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c1:[a-z2-7]{25}[aeimquy4]$"
          },
          "type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "meta": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "duration": {
                "type": "number",
                "minimum": 0
              },
              "pages": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": {}
          },
          "renditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "height": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0
                    },
                    "pages": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": {}
            }
          },
          "path": {
            "not": {}
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": {}
      }
    },
    "text": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^c1:[a-z2-7]{25}[aeimquy4]$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "file": {
          "not": {}
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": {}
    },
    "assetSources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(\\*|[a-z0-9][a-z0-9.+-]*)\\/(\\*|[a-z0-9][a-z0-9.+-]*)$"
            }
          },
          "priority": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "verify": {
            "type": "string",
            "enum": [
              "always",
              "first",
              "none"
            ]
          },
          "auth": {
            "type": "string",
            "enum": [
              "none",
              "bearer"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": {}
      }
    },
    "links": {
      "type": "string",
      "pattern": "^c1:[a-z2-7]{25}[aeimquy4]$"
    }
  },
  "required": [
    "format",
    "streamVersion",
    "formatVersion",
    "id",
    "title",
    "locale",
    "createdAt",
    "updatedAt",
    "pages",
    "assets",
    "assetSources"
  ],
  "additionalProperties": {}
}
