                "if": {
                  "required": [
                    "plugin"
                  ]
                },
                "then": {
                  "properties": {
                    "embed": {
                      "const": "plugin"
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "plugin"
                  ],
                  "properties": {
                    "plugin": {
                      "const": "chalk.lab"
                    }
                  }
                },
                "then": {
                  "required": [
                    "lab"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "lab"
                  ]
                },
                "then": {
                  "required": [
                    "plugin"
                  ],
                  "properties": {
                    "plugin": {
                      "const": "chalk.lab"
                    }
                  }
                }
