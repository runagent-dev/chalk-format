                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?:sha256:[0-9a-f]{64}|c1:[a-z2-7]{25}[aeimquy4])$"
                    }
                  },
                  "params": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {},
